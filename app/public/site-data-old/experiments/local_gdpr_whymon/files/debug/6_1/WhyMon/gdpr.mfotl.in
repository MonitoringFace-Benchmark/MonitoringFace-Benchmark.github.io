NOT ((( FORALL data.  FORALL dataid.  FORALL dsid. use(data, dataid, dsid)  IMPLIE SINCE   ( ONCE  legal_grounds(dsid, data))  OR  ( NOT  ds_revoke(dsid, data)  SINCE  ds_consent(dsid, data))))  AND 
(( FORALL data.  FORALL dataid.  FORALL dsid. ds_deletion_request(data, dataid, dsid)  IMPLIE SINCE    EVENTUALLY [0,30] delete(data, dataid, dsid)))  AND 
(( FORALL data.  FORALL dataid.  FORALL dsid. collect(data, dataid, dsid)  IMPLIE SINCE   ( NEXT  inform(dsid)  OR   ONCE  inform(dsid))))  AND 
(( FORALL data.  FORALL dataid.  FORALL dsid.  FORALL processorid. (ds_deletion_request(data, dataid, dsid)  AND   ONCE  share_with(processorid, dataid))  IMPLIE SINCE    EVENTUALLY [0,30] notify_proc(processorid, dataid))))